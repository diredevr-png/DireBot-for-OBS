// DireBot Face Avatar, 3D characters posed on the graphics card
// (src/face/avatar3d.cpp; Windows - Direct3D 11 - only: OBS's OpenGL sends
// only the first of a list of numbers, so there the CPU poses them):
// everything in direbot-face-3d.effect, and
//   DrawSk, DrawBumpedSk, OutlineSk, DepthSk, StrandSk, HullSk  Draw,
//            DrawBumped, Outline, Depth, Strand and Hull with the points
//            as made, moved
//            here by up to 4 bones each (a strand's points first by their
//            expression spot's move)
// A file of its own so OpenGL never builds the long list below.

#include "direbot-face-3d.effect"

// Each bone's matrix (world x its inverse bind; a part with no bones: its
// node's world as bone 0) as its 4 columns, up to 255 bones (rig.hpp's
// GPU_MOST_BONES); x of skin_info: -1 for a part its bones turn inside
// out (its tangents' w).
uniform float4 bone_cols[1020];
uniform float4 skin_info;
// Hair strands: how far its expressions move each of its spots now
// (model.hpp's Strands::moves; spot 0: not at all), up to 2047 of them.
uniform float4 spot_moves[2048];

// ---- Posed on the graphics card (the Sk techniques) ----
// The same sums as the CPU's (rig.cpp's skin): each bone's share of the
// point moved by it, facings and tangents turned by it, then made length 1.
struct Skinned {
	float3 pos;
	float3 norm;
	float3 tang;
};

float3 bone_point(int at, float3 p)
{
	return bone_cols[at].xyz * p.x + bone_cols[at + 1].xyz * p.y + bone_cols[at + 2].xyz * p.z +
	       bone_cols[at + 3].xyz;
}

float3 bone_turn(int at, float3 d)
{
	return bone_cols[at].xyz * d.x + bone_cols[at + 1].xyz * d.y + bone_cols[at + 2].xyz * d.z;
}

Skinned skinned(float3 p, float3 n, float3 t, float4 j, float4 w)
{
	Skinned o;
	o.pos = float3(0.0, 0.0, 0.0);
	o.norm = float3(0.0, 0.0, 0.0);
	o.tang = float3(0.0, 0.0, 0.0);
	int b0 = int(min(floor(j.x + 0.5), 254.0) * 4.0);
	int b1 = int(min(floor(j.y + 0.5), 254.0) * 4.0);
	int b2 = int(min(floor(j.z + 0.5), 254.0) * 4.0);
	int b3 = int(min(floor(j.w + 0.5), 254.0) * 4.0);
	if (w.x > 0.0) {
		o.pos = o.pos + bone_point(b0, p) * w.x;
		o.norm = o.norm + bone_turn(b0, n) * w.x;
		o.tang = o.tang + bone_turn(b0, t) * w.x;
	}
	if (w.y > 0.0) {
		o.pos = o.pos + bone_point(b1, p) * w.y;
		o.norm = o.norm + bone_turn(b1, n) * w.y;
		o.tang = o.tang + bone_turn(b1, t) * w.y;
	}
	if (w.z > 0.0) {
		o.pos = o.pos + bone_point(b2, p) * w.z;
		o.norm = o.norm + bone_turn(b2, n) * w.z;
		o.tang = o.tang + bone_turn(b2, t) * w.z;
	}
	if (w.w > 0.0) {
		o.pos = o.pos + bone_point(b3, p) * w.w;
		o.norm = o.norm + bone_turn(b3, n) * w.w;
		o.tang = o.tang + bone_turn(b3, t) * w.w;
	}
	float nl = length(o.norm);
	o.norm = nl > 0.0 ? o.norm / nl : float3(0.0, 0.0, 1.0);
	float tl = length(o.tang);
	o.tang = tl > 0.0 ? o.tang / tl : float3(1.0, 0.0, 0.0);
	return o;
}

struct SkinIn {
	float4 pos  : POSITION;
	float4 norm : NORMAL;
	float4 col  : COLOR;
	float2 uv   : TEXCOORD0;
	float4 jnt  : TEXCOORD1;
	float4 wgt  : TEXCOORD2;
};

struct SkinBumpIn {
	float4 pos  : POSITION;
	float4 norm : NORMAL;
	float4 col  : COLOR;
	float4 tang : TANGENT;
	float2 uv   : TEXCOORD0;
	float4 jnt  : TEXCOORD1;
	float4 wgt  : TEXCOORD2;
};

// A strand's point: as StrandIn, and its 4 bones, each one number: the
// bone's, plus how much it moves the point (0 to 0.999).
struct SkinStrandIn {
	float4 pos  : POSITION;
	float4 norm : NORMAL;
	float4 col  : COLOR;
	float4 jw   : TEXCOORD0;
};

VertOut VSDrawSk(SkinIn v)
{
	Skinned s = skinned(v.pos.xyz, v.norm.xyz, float3(1.0, 0.0, 0.0), v.jnt, v.wgt);
	return draw_out(s.pos, s.norm, v.col, v.uv);
}

BumpOut VSBumpedSk(SkinBumpIn v)
{
	Skinned s = skinned(v.pos.xyz, v.norm.xyz, v.tang.xyz, v.jnt, v.wgt);
	return bumped_out(s.pos, s.norm, float4(s.tang, v.tang.w * skin_info.x), v.col, v.uv);
}

VertOut VSOutlineSk(SkinIn v)
{
	Skinned s = skinned(v.pos.xyz, v.norm.xyz, float3(1.0, 0.0, 0.0), v.jnt, v.wgt);
	return outline_out(s.pos, s.norm, v.col, v.uv);
}

// Hidden hair left out before it's drawn (strand_view.w; Direct3D only -
// avatar3d.cpp gives the picture of the solid parts' distances to this
// stage itself, as OBS gives pictures to the pixel stage alone). Most of a
// coat is behind the body or under other hair, and every piece of it would
// still be cut into pixels only for PSStrand to throw each one away. So
// each point says whether it could show: not if everything is nearer than
// it - by more than a margin (strand_view.z), and what PSStrand allows a
// root - at its own pixel and the 8 round it, 4 and 8 pixels off (a piece
// is wider than its middle, and the hull's edge isn't sharp). The card
// drops a piece all of whose corners say no (SV_CullDistance) and draws
// the rest as before, PSStrand still judging every pixel. A point off the
// picture, or by its edge, always says yes.
struct StrandSkOut {
	float4 pos   : POSITION;
	float4 lit   : TEXCOORD0;
	float3 shine : TEXCOORD1;
	float4 uv    : TEXCOORD2;
	float  depth : TEXCOORD3;
	float  shown : SV_CullDistance0;
};

float strand_shown(float3 pos, float along)
{
	if (strand_view.w < 0.5)
		return 1.0;
	float shown = 1.0;
	float4 c = mul(float4(pos, 1.0), ViewProj);
	if (c.w > 0.0) {
		float2 at = float2(c.x / c.w * 0.5 + 0.5, 0.5 - c.y / c.w * 0.5) * strand_view.xy;
		if (at.x >= 9.0 && at.y >= 9.0 && at.x < strand_view.x - 9.0 && at.y < strand_view.y - 9.0) {
			int3 p = int3(int(at.x), int(at.y), 0);
			float far = depth_map.Load(p).r;
			far = max(far, depth_map.Load(p + int3(4, 0, 0)).r);
			far = max(far, depth_map.Load(p + int3(-4, 0, 0)).r);
			far = max(far, depth_map.Load(p + int3(0, 4, 0)).r);
			far = max(far, depth_map.Load(p + int3(0, -4, 0)).r);
			far = max(far, depth_map.Load(p + int3(8, 8, 0)).r);
			far = max(far, depth_map.Load(p + int3(-8, 8, 0)).r);
			far = max(far, depth_map.Load(p + int3(8, -8, 0)).r);
			far = max(far, depth_map.Load(p + int3(-8, -8, 0)).r);
			float depth = -mul(float4(pos, 1.0), cam).z;
			float t = saturate(along);
			if (depth > far + strand.w * (1.0 - t) * (1.0 - t) + strand_view.z)
				shown = -1.0;
		}
	}
	// (2, a test's view: only what would be left out.)
	return strand_view.w > 1.5 ? -shown : shown;
}

StrandSkOut VSStrandSk(SkinStrandIn v)
{
	float spot = floor(v.norm.w);
	int at = int(min(spot, 2047.0));
	float3 made = v.pos.xyz + spot_moves[at].xyz;
	float4 j = floor(v.jw);
	Skinned s = skinned(made, oct_dir(v.norm.xy), float3(1.0, 0.0, 0.0), j, (v.jw - j) / 0.999);
	float along = (v.norm.w - spot) / 0.9995;
	StrandOut o = strand_out(s.pos, s.norm, v.col, v.norm.z, along, abs(v.pos.w) - 1.0,
				 v.pos.w < 0.0 ? -1.0 : 1.0);
	StrandSkOut k;
	k.pos = o.pos;
	k.lit = o.lit;
	k.shine = o.shine;
	k.uv = o.uv;
	k.depth = o.depth;
	k.shown = strand_shown(s.pos, along);
	return k;
}

HullOut VSHullSk(SkinStrandIn v)
{
	float spot = floor(v.norm.w);
	int at = int(min(spot, 2047.0));
	float3 made = v.pos.xyz + spot_moves[at].xyz;
	float4 j = floor(v.jw);
	Skinned s = skinned(made, oct_dir(v.norm.xy), float3(1.0, 0.0, 0.0), j, (v.jw - j) / 0.999);
	return hull_out(s.pos, s.norm, v.col, v.norm.z, abs(v.pos.w) - 1.0, v.pos.w < 0.0 ? -1.0 : 1.0);
}

technique DrawSk
{
	pass
	{
		vertex_shader = VSDrawSk(v);
		pixel_shader  = PSDraw(v);
	}
}

technique DrawBumpedSk
{
	pass
	{
		vertex_shader = VSBumpedSk(v);
		pixel_shader  = PSDrawBumped(v);
	}
}

technique OutlineSk
{
	pass
	{
		vertex_shader = VSOutlineSk(v);
		pixel_shader  = PSOutline(v);
	}
}

technique DepthSk
{
	pass
	{
		vertex_shader = VSDrawSk(v);
		pixel_shader  = PSDepth(v);
	}
}

technique StrandSk
{
	pass
	{
		vertex_shader = VSStrandSk(v);
		pixel_shader  = PSStrand(v);
	}
}

technique HullSk
{
	pass
	{
		vertex_shader = VSHullSk(v);
		pixel_shader  = PSHull(v);
	}
}

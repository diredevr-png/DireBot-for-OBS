// DireBot Face Avatar, 3D characters (src/face/avatar3d.cpp):
//   Draw     a part of the character: its colour and pictures, lit glossy
//            (shine and reflections), as a cartoon (VRM's MToon: a shadow
//            colour, a rim of light) or flat - by the lights chosen
//            (src/face/lights.hpp), its occlusion map shading what the
//            room's light can't reach, soft skin letting light in a little
//   DrawBumped  the same, with a normal map's small bumps (its points
//            carry tangents for it)
//   Outline  a cartoon outline: the part pushed out along its facing, only
//            its far side drawn, so it shows round the edge
//   Hidden   the hidden head shape: only depth, so what's behind your
//            head is hidden
//   Down     the picture drawn twice the size, halved: smooth edges
// Points come already moved by the bones and expressions, in the world;
// `cam` takes them to the camera's view (x right, y up, looking along -z)
// for the light. Colours are worked in linear light and written as sRGB,
// premultiplied - a see-through part's shine, in the glossy look, on top
// (see shade_point's end).

uniform float4x4 ViewProj;
uniform float4x4 cam;
uniform texture2d base_map;
uniform texture2d shade_map;
uniform texture2d emissive_map;
uniform texture2d matcap_map;
uniform texture2d metal_map;
uniform texture2d image;
uniform texture2d normal_map;
uniform texture2d occlusion_map;
// Base colour (linear, with its see-through), emissive glow.
uniform float4 base_colour;
uniform float3 emissive;
// metal, rough, cutoff (0: none), see-through (1: blended)
uniform float4 surface;
// shadow shift, toony, rim power, rim lift
uniform float4 toon;
uniform float3 shade_colour;
uniform float3 rim_colour;
uniform float3 matcap_colour;
// look (0 glossy, 1 cartoon, 2 flat), rim mix, has a matcap picture (1), opacity
uniform float4 look;
// where the pictures land: move xy, size zw
uniform float4 uv_place;
// Outline: how far out (world units), its colour, how much it's lit.
uniform float outline_width;
uniform float4 outline_colour;
// Down: one texel of the big picture.
uniform float2 texel;
// The normal map's strength, the occlusion map's, soft skin (0 to 1),
// and 1 for a part drawn only from its front (0: both sides, or its back).
uniform float4 detail;
// The lights, in the camera's view (src/face/lights.hpp): towards the key
// light and its colour (linear, times its brightness), the second lamp's,
// the room's light from above and below, a rim light (its colour, and how
// close to the edge it stays), and the key light and the room as shares
// of the studio's (1 in the studio) for shine, reflections and cartoons.
uniform float3 key_dir;
uniform float3 key_colour;
uniform float3 fill_dir;
uniform float3 fill_colour;
uniform float3 room_up;
uniform float3 room_down;
uniform float4 rim_light;
uniform float3 key_tint;
uniform float3 room_tint;

sampler_state wrapSampler {
	Filter    = Linear;
	AddressU  = Wrap;
	AddressV  = Wrap;
};

sampler_state clampSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertIn {
	float4 pos  : POSITION;
	float4 norm : NORMAL;
	float4 col  : COLOR;
	float2 uv   : TEXCOORD0;
};

struct VertOut {
	float4 pos  : POSITION;
	float4 col  : COLOR;
	float2 uv   : TEXCOORD0;
	float3 vpos : TEXCOORD1;
	float3 vnrm : TEXCOORD2;
};

// A part with a normal map: its tangents too (xyz the way its picture's
// right is, w which way its up is).
struct BumpIn {
	float4 pos  : POSITION;
	float4 norm : NORMAL;
	float4 col  : COLOR;
	float4 tang : TANGENT;
	float2 uv   : TEXCOORD0;
};

struct BumpOut {
	float4 pos  : POSITION;
	float4 col  : COLOR;
	float2 uv   : TEXCOORD0;
	float3 vpos : TEXCOORD1;
	float3 vnrm : TEXCOORD2;
	float4 vtan : TEXCOORD3;
};

VertOut VSDraw(VertIn v)
{
	VertOut o;
	o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
	o.col = v.col;
	o.uv = v.uv * uv_place.zw + uv_place.xy;
	o.vpos = mul(float4(v.pos.xyz, 1.0), cam).xyz;
	o.vnrm = mul(float4(v.norm.xyz, 0.0), cam).xyz;
	return o;
}

BumpOut VSBumped(BumpIn v)
{
	BumpOut o;
	o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
	o.col = v.col;
	o.uv = v.uv * uv_place.zw + uv_place.xy;
	o.vpos = mul(float4(v.pos.xyz, 1.0), cam).xyz;
	o.vnrm = mul(float4(v.norm.xyz, 0.0), cam).xyz;
	o.vtan = float4(mul(float4(v.tang.xyz, 0.0), cam).xyz, v.tang.w);
	return o;
}

VertOut VSOutline(VertIn v)
{
	VertOut o;
	float3 p = v.pos.xyz + v.norm.xyz * outline_width;
	o.pos = mul(float4(p, 1.0), ViewProj);
	o.col = v.col;
	o.uv = v.uv * uv_place.zw + uv_place.xy;
	o.vpos = mul(float4(p, 1.0), cam).xyz;
	o.vnrm = mul(float4(v.norm.xyz, 0.0), cam).xyz;
	return o;
}

float3 lin(float3 c)
{
	return pow(max(c, float3(0.0, 0.0, 0.0)), float3(2.2, 2.2, 2.2));
}

float3 srgb(float3 c)
{
	return pow(saturate(c), float3(1.0 / 2.2, 1.0 / 2.2, 1.0 / 2.2));
}

// A soft studio round it: bright above, a bright window up and to the
// left, darker below - what shiny parts reflect.
float3 studio(float3 r)
{
	float up = saturate(r.y * 0.5 + 0.5);
	float3 c = lerp(float3(0.10, 0.10, 0.11), float3(0.95, 0.96, 1.0), up * up);
	float window = saturate((dot(r, normalize(float3(-0.45, 0.55, 0.7))) - 0.82) * 8.0);
	return c + float3(1.6, 1.6, 1.6) * window;
}

// Light that reaches a point whose facing is `nl` towards it: all of it
// facing it, none facing away - or, soft skin, a little round the edge
// too, red the furthest (light that went in under the skin).
float3 reaching(float nl, float3 soft)
{
	return saturate((float3(nl, nl, nl) + soft) / (float3(1.0, 1.0, 1.0) + soft));
}

// A point of a part: its colour and pictures at `uv`, facing `N` (its
// normal map's bumps in it) on a part facing `Ng`, seen from `V`, lit.
float4 shade_point(float2 uv, float4 vcol, float3 V, float3 N, float3 Ng)
{
	// Every picture is read first, the same way at every point.
	float4 tex = base_map.Sample(wrapSampler, uv);
	float4 shade_tex = shade_map.Sample(wrapSampler, uv);
	float4 glow_tex = emissive_map.Sample(wrapSampler, uv);
	float4 mr = metal_map.Sample(wrapSampler, uv);
	float4 occ = occlusion_map.Sample(wrapSampler, uv);
	float2 cap_uv = float2(N.x * 0.5 + 0.5, 0.5 - N.y * 0.5);
	float4 cap = matcap_map.Sample(clampSampler, cap_uv);

	float4 base = base_colour * float4(lin(tex.rgb), tex.a) * float4(lin(vcol.rgb), vcol.a);
	float alpha = base.a * look.w;
	if (surface.z > 0.0 && base.a < surface.z)
		discard;
	if (surface.w < 0.5)
		alpha = look.w;
	float3 glow = emissive * lin(glow_tex.rgb);

	float3 L = key_dir;
	float3 L2 = fill_dir;
	float nl = dot(N, L);
	float nv = saturate(dot(N, V));
	// The rim light: round the edge, more where it's seen side on.
	float3 rim_lit = rim_light.rgb * pow(1.0 - nv, max(rim_light.w, 0.001));
	float3 col;
	float3 shine = float3(0.0, 0.0, 0.0);
	if (look.x > 1.5) {
		col = base.rgb + glow;
	} else if (look.x > 0.5) {
		// Cartoon: lit or in shadow, with a sharp or soft line between.
		float s = nl + toon.x;
		float t = saturate((s - (-1.0 + toon.y)) / max(0.0001, 2.0 - 2.0 * toon.y));
		float3 shade = shade_colour * lin(shade_tex.rgb);
		col = lerp(shade, base.rgb, t) * key_tint;
		col = col + base.rgb * 0.12 * room_tint;
		float rim = pow(saturate(1.0 - nv + toon.w), max(toon.z, 0.001));
		col = col + (rim_colour * rim + rim_lit) * lerp(1.0, saturate(t + 0.3), look.y);
		col = col + matcap_colour * lin(cap.rgb) * look.z;
		col = col + glow;
	} else {
		// Glossy: light from two lamps and the room, shine, and the
		// studio reflected; what the room can't reach (its occlusion
		// map) shaded. Soft skin: light from round the edge too, the
		// bumps softer under it.
		float ao = lerp(1.0, occ.r, detail.y);
		float metal = saturate(surface.x * mr.b);
		float rough = saturate(surface.y * mr.g);
		float a = max(rough * rough, 0.003);
		float3 f0 = lerp(float3(0.04, 0.04, 0.04), base.rgb, metal);
		float3 diffuse = base.rgb * (1.0 - metal);
		float3 ambient = lerp(room_down, room_up, N.y * 0.5 + 0.5) * ao;
		float3 soft = float3(0.5, 0.3, 0.22) * detail.z;
		float3 Nd = normalize(lerp(N, Ng, detail.z * 0.5));
		col = diffuse * (ambient + key_colour * reaching(dot(Nd, L), soft) +
				 fill_colour * reaching(dot(Nd, L2), soft));
		float3 H = normalize(L + V);
		float nh = saturate(dot(N, H));
		float d = nh * nh * (a * a - 1.0) + 1.0;
		float D = a * a / (3.14159 * d * d);
		float k = (rough + 1.0) * (rough + 1.0) / 8.0;
		float G = 1.0 / ((nv * (1.0 - k) + k) * (saturate(nl) * (1.0 - k) + k));
		float3 F = f0 + (float3(1.0, 1.0, 1.0) - f0) * pow(1.0 - saturate(dot(H, V)), 5.0);
		shine = D * G * F * saturate(nl) * 0.25 * key_tint;
		float3 R = reflect(-V, N);
		float3 env = lerp(studio(R), float3(0.5, 0.5, 0.52), rough);
		float3 fe = f0 + (max(float3(1.0 - rough, 1.0 - rough, 1.0 - rough), f0) - f0) * pow(1.0 - nv, 5.0);
		shine = shine + env * fe * (1.0 - rough * 0.7) * room_tint * ao;
		col = col + rim_lit * ao;
		col = col + glow;
		// A see-through part (glTF's BLEND): its own colour shows as much
		// as it's solid, but the light it reflects as much as it's there
		// at all - its picture's and points' see-through, not its
		// material's - so a clear lens, visor or eye's front keeps its
		// shine, and the empty parts of a hair card or decal gain none.
		// (Added over its colour as much as that shows, premultiplied:
		// the light on top of what's behind it.)
		if (surface.w >= 0.5) {
			float there = saturate(tex.a * vcol.a) * look.w;
			float3 shown = col * alpha;
			return float4(srgb(col) * alpha + (srgb(shown + shine) - srgb(shown)) * there, alpha);
		}
		col = col + shine;
	}
	return float4(srgb(col) * alpha, alpha);
}

// Its facing at a point, towards the camera. A part drawn on both sides
// (or only its back) shows back faces: their facing turns round. A part
// drawn only from its front shows none, so a facing leaning away there is
// a smooth one just past side-on at its edge: laid side-on instead, as
// turned round it would light that edge as if it faced the other way (a
// bright or dark line along its outline). One leaning far away is a file's
// facings made inside out: turned round, as ever.
float3 towards_camera(float3 N, float3 V)
{
	float nv = dot(N, V);
	if (nv >= 0.0)
		return N;
	if (detail.w > 0.5 && nv > -0.7)
		return normalize(N - V * nv);
	return -N;
}

float4 PSDraw(VertOut v) : TARGET
{
	float3 V = normalize(-v.vpos);
	float3 N = towards_camera(normalize(v.vnrm), V);
	return shade_point(v.uv, v.col, V, N, N);
}

float4 PSDrawBumped(BumpOut v) : TARGET
{
	// glTF's normal maps: red the picture's right, green its up, blue
	// straight out; strength scales right and up.
	float4 bump = normal_map.Sample(wrapSampler, v.uv);
	float3 Ng = normalize(v.vnrm);
	float3 V = normalize(-v.vpos);
	// Its back (towards_camera turned it round), or an edge laid side-on.
	float3 Nc = towards_camera(Ng, V);
	float face = dot(Nc, Ng) < 0.0 ? -1.0 : 1.0;
	if (face > 0.0)
		Ng = Nc;
	float3 T = v.vtan.xyz - Ng * dot(Ng, v.vtan.xyz);
	float tl = length(T);
	T = tl > 0.00001 ? T / tl : float3(0.0, 0.0, 0.0);
	float3 B = cross(Ng, T) * (v.vtan.w < 0.0 ? -1.0 : 1.0);
	float3 n = bump.xyz * 2.0 - float3(1.0, 1.0, 1.0);
	n.xy = n.xy * detail.x;
	float3 N = T * n.x + B * n.y + Ng * max(n.z, 0.0);
	float len = length(N);
	N = len > 0.00001 ? N / len : Ng;
	// Its back (seen from behind): the whole facing turned round.
	return shade_point(v.uv, v.col, V, N * face, Ng * face);
}

float4 PSOutline(VertOut v) : TARGET
{
	float4 tex = base_map.Sample(wrapSampler, v.uv);
	float3 N = normalize(v.vnrm);
	float3 V = normalize(-v.vpos);
	// Only the far side: the near side would cover the part itself.
	if (dot(N, V) > 0.0)
		discard;
	if (surface.z > 0.0 && base_colour.a * tex.a < surface.z)
		discard;
	float3 c = outline_colour.rgb;
	float3 lit = c * lerp(float3(1.0, 1.0, 1.0), key_tint * 0.85, outline_colour.a);
	return float4(srgb(lit) * look.w, look.w);
}

float4 PSHidden(VertOut v) : TARGET
{
	return float4(0.0, 0.0, 0.0, 0.0);
}

struct DownData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

DownData VSDown(DownData v)
{
	DownData o;
	o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
	o.uv = v.uv;
	return o;
}

float4 PSDown(DownData v) : TARGET
{
	// Each pixel is the middle of 2 x 2 of the big picture's, so one
	// smooth read is their average; two more either side soften it.
	float4 c = image.Sample(clampSampler, v.uv) * 0.5;
	c = c + image.Sample(clampSampler, v.uv + float2(texel.x, 0.0)) * 0.125;
	c = c + image.Sample(clampSampler, v.uv - float2(texel.x, 0.0)) * 0.125;
	c = c + image.Sample(clampSampler, v.uv + float2(0.0, texel.y)) * 0.125;
	c = c + image.Sample(clampSampler, v.uv - float2(0.0, texel.y)) * 0.125;
	return c;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDraw(v);
		pixel_shader  = PSDraw(v);
	}
}

technique DrawBumped
{
	pass
	{
		vertex_shader = VSBumped(v);
		pixel_shader  = PSDrawBumped(v);
	}
}

technique Outline
{
	pass
	{
		vertex_shader = VSOutline(v);
		pixel_shader  = PSOutline(v);
	}
}

technique Hidden
{
	pass
	{
		vertex_shader = VSDraw(v);
		pixel_shader  = PSHidden(v);
	}
}

technique Down
{
	pass
	{
		vertex_shader = VSDown(v);
		pixel_shader  = PSDown(v);
	}
}

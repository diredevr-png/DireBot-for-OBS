// DireBot Face Avatar, 3D characters (src/face/avatar3d.cpp):
//   Draw     a part of the character: its colour and pictures, lit glossy
//            (shine and reflections), as a cartoon (VRM's MToon: a shadow
//            colour, a rim of light) or flat - by the lights chosen
//            (src/face/lights.hpp), its occlusion map shading what the
//            room's light can't reach, soft skin letting light in a little
//   DrawBumped  the same, with a normal map's small bumps (its points
//            carry tangents for it)
//   Outline  a cartoon outline: the part pushed out along its facing, only
//            its far side drawn, so it shows round the edge
//   Hidden   the hidden head shape: only depth, so what's behind your
//            head is hidden
//   Strand   hair strands (a file's lines: model.hpp's Strands), each
//            piece a thin ribbon turned to face the camera, at least
//            `strand.y` pixels wide - a thinner hair is as see-through as
//            it's thinner, so many of them over one another blend smoothly
//            (drawn from the back: avatar3d.cpp). Only the first share of
//            a part's strands is sent (`strand_lod.x`), each as much wider
//            as makes up for the rest. Lit as hair is - across its length,
//            with a white shine and a coloured one from inside it - at
//            its points, and hidden where a solid part is in front by the
//            picture of their depths (`depth_map`: hairs write no depth).
//            Hairs under a pixel wide are sent as lines instead (the same
//            picture for half the work: `strand_lod.z`)
//   Depth    a solid part's distance from the camera, for that picture
//   Hull     the inner layers of the hairs into that picture too
//   Down     the picture drawn twice the size, halved: smooth edges
// Points come already moved by the bones and expressions, in the world;
// `cam` takes them to the camera's view (x right, y up, looking along -z)
// for the light. Colours are worked in linear light and written as sRGB,
// premultiplied - a see-through part's shine, in the glossy look, on top
// (see shade_point's end).

uniform float4x4 ViewProj;
uniform float4x4 cam;
uniform texture2d base_map;
uniform texture2d shade_map;
uniform texture2d emissive_map;
uniform texture2d matcap_map;
uniform texture2d metal_map;
uniform texture2d image;
uniform texture2d normal_map;
uniform texture2d occlusion_map;
// Base colour (linear, with its see-through), emissive glow.
uniform float4 base_colour;
uniform float3 emissive;
// metal, rough, cutoff (0: none), see-through (1: blended)
uniform float4 surface;
// shadow shift, toony, rim power, rim lift
uniform float4 toon;
uniform float3 shade_colour;
uniform float3 rim_colour;
uniform float3 matcap_colour;
// look (0 glossy, 1 cartoon, 2 flat), rim mix, has a matcap picture (1), opacity
uniform float4 look;
// where the pictures land: move xy, size zw
uniform float4 uv_place;
// 0.9.0, a glowing part (fire, sparks, smoke): 1 (else 0), how fast it
// thins out seen edge on (a power), how ragged its outline (0: a smooth
// fade) - see shade_point.
uniform float4 gas;
// 0.9.0: w 1: every point of the part drawn at the depth of this point
// in the world (xyz; its middle), so a soft glowing puff never cuts into
// itself or the puffs drawn before it (OBS can't draw without writing
// depth); w 0: as they are.
uniform float4 flat_at;
// Strand: where the camera is (the world); `strand`: how wide one pixel
// is a unit from the camera (x), the thinnest a hair is drawn, in pixels
// (y), how much bigger its bones make it (z: its widths are the file's)
// and how far behind a solid part its root still shows (w: it sits on the
// skin); `strand_lod`: the threshold its strands are drawn up to (x: the
// ones whose keys are under it), (Hull) how much further off than it is a
// hair of the hull is written (y), and 1 when its pieces are sent as lines
// (z: hairs thinner than a pixel - a line is a pixel wide, so it's the
// same picture for half the triangles; avatar3d.cpp says when);
// `strand_view`: the picture's size in pixels (x y), and for leaving
// hidden hair out before it's drawn (the -skin effect's strand_shown):
// how much further off than what's in front of it a point has to be (z)
// and whether it's done (w: 0 no, 1 yes, 2 only the hair left out is drawn
// - a test's view of it; 3 and 4 measure: every piece left out, and the
// test made with nothing left out).
uniform float3 eye_pos;
uniform float4 strand;
uniform float4 strand_lod;
uniform float4 strand_view;
uniform texture2d depth_map;
// Outline: how far out (world units), its colour, how much it's lit.
uniform float outline_width;
uniform float4 outline_colour;
// Down: one texel of the big picture.
uniform float2 texel;
// The normal map's strength, the occlusion map's, soft skin (0 to 1),
// and 1 for a part drawn only from its front (0: both sides, or its back).
uniform float4 detail;
// The lights, in the camera's view (src/face/lights.hpp): towards the key
// light and its colour (linear, times its brightness), the second lamp's,
// the room's light from above and below, a rim light (its colour, and how
// close to the edge it stays), and the key light and the room as shares
// of the studio's (1 in the studio) for shine, reflections and cartoons.
uniform float3 key_dir;
uniform float3 key_colour;
uniform float3 fill_dir;
uniform float3 fill_colour;
uniform float3 room_up;
uniform float3 room_down;
uniform float4 rim_light;
uniform float3 key_tint;
uniform float3 room_tint;

sampler_state wrapSampler {
	Filter    = Linear;
	AddressU  = Wrap;
	AddressV  = Wrap;
};

sampler_state clampSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertIn {
	float4 pos  : POSITION;
	float4 norm : NORMAL;
	float4 col  : COLOR;
	float2 uv   : TEXCOORD0;
};

struct VertOut {
	float4 pos  : POSITION;
	float4 col  : COLOR;
	float2 uv   : TEXCOORD0;
	float3 vpos : TEXCOORD1;
	float3 vnrm : TEXCOORD2;
};

// A part with a normal map: its tangents too (xyz the way its picture's
// right is, w which way its up is).
struct BumpIn {
	float4 pos  : POSITION;
	float4 norm : NORMAL;
	float4 col  : COLOR;
	float4 tang : TANGENT;
	float2 uv   : TEXCOORD0;
};

struct BumpOut {
	float4 pos  : POSITION;
	float4 col  : COLOR;
	float2 uv   : TEXCOORD0;
	float3 vpos : TEXCOORD1;
	float3 vnrm : TEXCOORD2;
	float4 vtan : TEXCOORD3;
};

// Every point of a part at the depth of `flat_at`: all of them with its
// w, so z / w comes out the very same number everywhere (no rounding
// between them: the part never fails the depth test against itself),
// and x and y scaled to stay put on the picture. A point reaching past the
// camera is left out (beyond the far end).
float4 flattened(float4 p)
{
	if (flat_at.w < 0.5)
		return p;
	float4 c = mul(float4(flat_at.xyz, 1.0), ViewProj);
	if (c.w > 0.0 && p.w > 0.05 * c.w)
		return float4(p.xy * (c.w / p.w), c.z, c.w);
	return float4(0.0, 0.0, 2.0, 1.0);
}

// (Each technique's points as plain numbers, so the Sk techniques share
// them: OpenGL takes an entry's input struct for its own.)
VertOut draw_out(float3 pos, float3 norm, float4 col, float2 uv)
{
	VertOut o;
	o.pos = flattened(mul(float4(pos, 1.0), ViewProj));
	o.col = col;
	o.uv = uv * uv_place.zw + uv_place.xy;
	o.vpos = mul(float4(pos, 1.0), cam).xyz;
	o.vnrm = mul(float4(norm, 0.0), cam).xyz;
	return o;
}

VertOut VSDraw(VertIn v)
{
	return draw_out(v.pos.xyz, v.norm.xyz, v.col, v.uv);
}

BumpOut bumped_out(float3 pos, float3 norm, float4 tang, float4 col, float2 uv)
{
	BumpOut o;
	o.pos = flattened(mul(float4(pos, 1.0), ViewProj));
	o.col = col;
	o.uv = uv * uv_place.zw + uv_place.xy;
	o.vpos = mul(float4(pos, 1.0), cam).xyz;
	o.vnrm = mul(float4(norm, 0.0), cam).xyz;
	o.vtan = float4(mul(float4(tang.xyz, 0.0), cam).xyz, tang.w);
	return o;
}

BumpOut VSBumped(BumpIn v)
{
	return bumped_out(v.pos.xyz, v.norm.xyz, v.tang, v.col, v.uv);
}

VertOut outline_out(float3 pos, float3 norm, float4 col, float2 uv)
{
	VertOut o;
	float3 p = pos + norm * outline_width;
	o.pos = mul(float4(p, 1.0), ViewProj);
	o.col = col;
	o.uv = uv * uv_place.zw + uv_place.xy;
	o.vpos = mul(float4(p, 1.0), cam).xyz;
	o.vnrm = mul(float4(norm, 0.0), cam).xyz;
	return o;
}

VertOut VSOutline(VertIn v)
{
	return outline_out(v.pos.xyz, v.norm.xyz, v.col, v.uv);
}

float3 lin(float3 c)
{
	return pow(max(c, float3(0.0, 0.0, 0.0)), float3(2.2, 2.2, 2.2));
}

float3 srgb(float3 c)
{
	return pow(saturate(c), float3(1.0 / 2.2, 1.0 / 2.2, 1.0 / 2.2));
}

// A soft studio round it: bright above, a bright window up and to the
// left, darker below - what shiny parts reflect.
float3 studio(float3 r)
{
	float up = saturate(r.y * 0.5 + 0.5);
	float3 c = lerp(float3(0.10, 0.10, 0.11), float3(0.95, 0.96, 1.0), up * up);
	float window = saturate((dot(r, normalize(float3(-0.45, 0.55, 0.7))) - 0.82) * 8.0);
	return c + float3(1.6, 1.6, 1.6) * window;
}

// Light that reaches a point whose facing is `nl` towards it: all of it
// facing it, none facing away - or, soft skin, a little round the edge
// too, red the furthest (light that went in under the skin).
float3 reaching(float nl, float3 soft)
{
	return saturate((float3(nl, nl, nl) + soft) / (float3(1.0, 1.0, 1.0) + soft));
}

// A point of a part: its colour and pictures at `uv`, facing `N` (its
// normal map's bumps in it) on a part facing `Ng`, seen from `V`, lit.
float4 shade_point(float2 uv, float4 vcol, float3 V, float3 N, float3 Ng)
{
	// Every picture is read first, the same way at every point.
	float4 tex = base_map.Sample(wrapSampler, uv);
	float4 shade_tex = shade_map.Sample(wrapSampler, uv);
	float4 glow_tex = emissive_map.Sample(wrapSampler, uv);
	float4 mr = metal_map.Sample(wrapSampler, uv);
	float4 occ = occlusion_map.Sample(wrapSampler, uv);
	float2 cap_uv = float2(N.x * 0.5 + 0.5, 0.5 - N.y * 0.5);
	float4 cap = matcap_map.Sample(clampSampler, cap_uv);

	// A glowing part (0.9.0: fire, sparks, smoke): a soft see-through gas.
	// Its light (its emissive colour x its picture x its points' colour) is
	// added to what's behind it, however see-through it is; what's behind
	// it is hidden only as much as its base colour's alpha says (soot a lot,
	// a white-hot flame hardly at all). Seen edge on it thins out (gas.y,
	// a power) - with gas.z, eating into its picture's thin places first,
	// so its outline breaks up into wisps along its swirls. Premultiplied,
	// as everything here is.
	if (gas.x > 0.5) {
		float e = pow(saturate(abs(dot(Ng, V))), max(gas.y, 0.001));
		float shape = gas.z > 0.0 ? saturate((tex.a - (1.0 - e)) / gas.z) : saturate(tex.a) * e;
		float there = shape * saturate(vcol.a) * look.w;
		if (there < 0.004)
			discard;
		float a = saturate(base_colour.a) * there;
		float3 vc = lin(vcol.rgb);
		float3 body = base_colour.rgb * lin(tex.rgb) * vc;
		float3 light = emissive * lin(glow_tex.rgb) * vc;
		return float4(srgb(body) * a + srgb(light) * there, a);
	}

	float4 base = base_colour * float4(lin(tex.rgb), tex.a) * float4(lin(vcol.rgb), vcol.a);
	float alpha = base.a * look.w;
	if (surface.z > 0.0 && base.a < surface.z)
		discard;
	// A see-through part's empty pixels (none of its picture or points
	// there: a hair card's gaps) aren't drawn at all, so they don't hide
	// what's behind them.
	if (surface.w >= 0.5 && saturate(tex.a * vcol.a) * look.w < 0.004)
		discard;
	if (surface.w < 0.5)
		alpha = look.w;
	float3 glow = emissive * lin(glow_tex.rgb);

	float3 L = key_dir;
	float3 L2 = fill_dir;
	float nl = dot(N, L);
	float nv = saturate(dot(N, V));
	// The rim light: round the edge, more where it's seen side on.
	float3 rim_lit = rim_light.rgb * pow(1.0 - nv, max(rim_light.w, 0.001));
	float3 col;
	float3 shine = float3(0.0, 0.0, 0.0);
	if (look.x > 1.5) {
		col = base.rgb + glow;
	} else if (look.x > 0.5) {
		// Cartoon: lit or in shadow, with a sharp or soft line between.
		float s = nl + toon.x;
		float t = saturate((s - (-1.0 + toon.y)) / max(0.0001, 2.0 - 2.0 * toon.y));
		float3 shade = shade_colour * lin(shade_tex.rgb);
		col = lerp(shade, base.rgb, t) * key_tint;
		col = col + base.rgb * 0.12 * room_tint;
		float rim = pow(saturate(1.0 - nv + toon.w), max(toon.z, 0.001));
		col = col + (rim_colour * rim + rim_lit) * lerp(1.0, saturate(t + 0.3), look.y);
		col = col + matcap_colour * lin(cap.rgb) * look.z;
		col = col + glow;
	} else {
		// Glossy: light from two lamps and the room, shine, and the
		// studio reflected; what the room can't reach (its occlusion
		// map) shaded. Soft skin: light from round the edge too, the
		// bumps softer under it.
		float ao = lerp(1.0, occ.r, detail.y);
		float metal = saturate(surface.x * mr.b);
		float rough = saturate(surface.y * mr.g);
		float a = max(rough * rough, 0.003);
		float3 f0 = lerp(float3(0.04, 0.04, 0.04), base.rgb, metal);
		float3 diffuse = base.rgb * (1.0 - metal);
		float3 ambient = lerp(room_down, room_up, N.y * 0.5 + 0.5) * ao;
		float3 soft = float3(0.5, 0.3, 0.22) * detail.z;
		float3 Nd = normalize(lerp(N, Ng, detail.z * 0.5));
		col = diffuse * (ambient + key_colour * reaching(dot(Nd, L), soft) +
				 fill_colour * reaching(dot(Nd, L2), soft));
		float3 H = normalize(L + V);
		float nh = saturate(dot(N, H));
		float d = nh * nh * (a * a - 1.0) + 1.0;
		float D = a * a / (3.14159 * d * d);
		float k = (rough + 1.0) * (rough + 1.0) / 8.0;
		float G = 1.0 / ((nv * (1.0 - k) + k) * (saturate(nl) * (1.0 - k) + k));
		float3 F = f0 + (float3(1.0, 1.0, 1.0) - f0) * pow(1.0 - saturate(dot(H, V)), 5.0);
		shine = D * G * F * saturate(nl) * 0.25 * key_tint;
		float3 R = reflect(-V, N);
		float3 env = lerp(studio(R), float3(0.5, 0.5, 0.52), rough);
		float3 fe = f0 + (max(float3(1.0 - rough, 1.0 - rough, 1.0 - rough), f0) - f0) * pow(1.0 - nv, 5.0);
		shine = shine + env * fe * (1.0 - rough * 0.7) * room_tint * ao;
		col = col + rim_lit * ao;
		col = col + glow;
		// A see-through part (glTF's BLEND): its own colour shows as much
		// as it's solid, but the light it reflects as much as it's there
		// at all - its picture's and points' see-through, not its
		// material's - so a clear lens, visor or eye's front keeps its
		// shine, and the empty parts of a hair card or decal gain none.
		// (Added over its colour as much as that shows, premultiplied:
		// the light on top of what's behind it.)
		if (surface.w >= 0.5) {
			float there = saturate(tex.a * vcol.a) * look.w;
			float3 shown = col * alpha;
			return float4(srgb(col) * alpha + (srgb(shown + shine) - srgb(shown)) * there, alpha);
		}
		col = col + shine;
	}
	return float4(srgb(col) * alpha, alpha);
}

// Its facing at a point, towards the camera. A part drawn on both sides
// (or only its back) shows back faces: their facing turns round. A part
// drawn only from its front shows none, so a facing leaning away there is
// a smooth one just past side-on at its edge: laid side-on instead, as
// turned round it would light that edge as if it faced the other way (a
// bright or dark line along its outline). One leaning far away is a file's
// facings made inside out: turned round, as ever.
float3 towards_camera(float3 N, float3 V)
{
	float nv = dot(N, V);
	if (nv >= 0.0)
		return N;
	if (detail.w > 0.5 && nv > -0.7)
		return normalize(N - V * nv);
	return -N;
}

float4 PSDraw(VertOut v) : TARGET
{
	float3 V = normalize(-v.vpos);
	float3 N = towards_camera(normalize(v.vnrm), V);
	return shade_point(v.uv, v.col, V, N, N);
}

float4 PSDrawBumped(BumpOut v) : TARGET
{
	// glTF's normal maps: red the picture's right, green its up, blue
	// straight out; strength scales right and up.
	float4 bump = normal_map.Sample(wrapSampler, v.uv);
	float3 Ng = normalize(v.vnrm);
	float3 V = normalize(-v.vpos);
	// Its back (towards_camera turned it round), or an edge laid side-on.
	float3 Nc = towards_camera(Ng, V);
	float face = dot(Nc, Ng) < 0.0 ? -1.0 : 1.0;
	if (face > 0.0)
		Ng = Nc;
	float3 T = v.vtan.xyz - Ng * dot(Ng, v.vtan.xyz);
	float tl = length(T);
	T = tl > 0.00001 ? T / tl : float3(0.0, 0.0, 0.0);
	float3 B = cross(Ng, T) * (v.vtan.w < 0.0 ? -1.0 : 1.0);
	float3 n = bump.xyz * 2.0 - float3(1.0, 1.0, 1.0);
	n.xy = n.xy * detail.x;
	float3 N = T * n.x + B * n.y + Ng * max(n.z, 0.0);
	float len = length(N);
	N = len > 0.00001 ? N / len : Ng;
	// Its back (seen from behind): the whole facing turned round.
	return shade_point(v.uv, v.col, V, N * face, Ng * face);
}

float4 PSOutline(VertOut v) : TARGET
{
	float4 tex = base_map.Sample(wrapSampler, v.uv);
	float3 N = normalize(v.vnrm);
	float3 V = normalize(-v.vpos);
	// Only the far side: the near side would cover the part itself.
	if (dot(N, V) > 0.0)
		discard;
	if (surface.z > 0.0 && base_colour.a * tex.a < surface.z)
		discard;
	float3 c = outline_colour.rgb;
	float3 lit = c * lerp(float3(1.0, 1.0, 1.0), key_tint * 0.85, outline_colour.a);
	return float4(srgb(lit) * look.w, look.w);
}

float4 PSHidden(VertOut v) : TARGET
{
	return float4(0.0, 0.0, 0.0, 0.0);
}

// A solid part's distance from the camera (the picture hairs are hidden
// by): its cut-out pixels left out, as they are when it's drawn.
float4 PSDepth(VertOut v) : TARGET
{
	float4 tex = base_map.Sample(wrapSampler, v.uv);
	if (surface.z > 0.0 && base_colour.a * tex.a * v.col.a < surface.z)
		discard;
	return float4(-v.vpos.z, 0.0, 0.0, 1.0);
}

// Hair strands: see Strand at the top. Each point comes twice, its two
// sides: `pos.w` + or - (which side) 1 and its strand's key and rate as
// one whole number (strand_share takes it apart); `norm` the way its strand
// runs (xy: folded onto a square, oct_dir unfolds it), its width (z, the
// file's units) and (w) its expression spot's number plus how far along
// its strand it is (0 root to 0.9995 tip).
struct StrandIn {
	float4 pos  : POSITION;
	float4 norm : NORMAL;
	float4 col  : COLOR;
};

// lit: what its picture's colour is multiplied by (rgb) and how much of
// its pixels it covers (a); shine: added on top; uv: where its pictures
// are read (x its strand's own number, y how far along), which side of
// the ribbon (z, -1 to 1) and how much it's rounded across (w: a hair
// wider than a pixel or two); depth: its distance from the camera.
struct StrandOut {
	float4 pos   : POSITION;
	float4 lit   : TEXCOORD0;
	float3 shine : TEXCOORD1;
	float4 uv    : TEXCOORD2;
	float  depth : TEXCOORD3;
};

float3 oct_dir(float2 e)
{
	float3 n = float3(e.x, e.y, 1.0 - abs(e.x) - abs(e.y));
	float t = max(-n.z, 0.0);
	n.x += n.x >= 0.0 ? -t : t;
	n.y += n.y >= 0.0 ? -t : t;
	return normalize(n);
}

// A strand's `order`: its key in steps of 1 / 32768 (under 131072 of
// them) and its rate's step (0 to 63: 0.25 to 1) x 131072. Its key says
// where it comes in the draw order: the strands drawn are the ones whose
// keys are under the threshold (strand_lod.x), the last tenth of them
// thinning away, so none pops in or out as the threshold changes. Its
// rate says how much of the hair round it that draws: threshold x rate
// of it (all of it at 1 and over) - thin fur at a higher rate than deep,
// so the deep coat is thinned first. Each hair is drawn as much wider as
// makes up for the ones left out. Returns its key (x), how much of it is
// left where it's thinning away (y), the share of the hair round it
// that's drawn (z) and how much wider it's drawn for that (w).
float4 strand_share(float order)
{
	float level = floor(order / 131072.0);
	float key = (order - level * 131072.0) / 32768.0;
	float rate = 0.25 + 0.75 * level / 63.0;
	float upto = max(strand_lod.x, 0.000001);
	float fade = saturate((upto - key) / (upto * 0.1));
	// (How much of its hair that leaves, with the thinning ones counted
	// for what's left of them.)
	float a = upto * rate;
	float left = 0.95 * a;
	if (a > 1.0)
		left = a >= 1.1111111 ? 1.0 : 0.9 * a + (0.01 * a * a - (a - 1.0) * (a - 1.0)) / (0.2 * a);
	return float4(key, fade, min(a, 1.0), fade / left);
}

StrandOut strand_out(float3 pos, float3 run, float4 col, float width, float along, float order, float side)
{
	StrandOut o;
	float3 P = pos;
	float3 T = normalize(run);
	float3 E = eye_pos - P;
	float d = max(length(E), 0.0001);
	float3 S = cross(T, E / d);
	float sl = length(S);
	S = sl > 0.00001 ? S / sl : normalize(cross(T, float3(0.0, 1.0, 0.001)));
	// (Only some of the strands are drawn, each as much wider.)
	float4 drawn = strand_share(order);
	float w = max(width, 0.0) * strand.z * drawn.w;
	// As wide as that, but never thinner than strand.y pixels: then it
	// covers only its share of them.
	float px = d * strand.x;
	float wd = max(w, px * strand.y);
	// (Sent as lines - strand_lod.z: its middle, the card draws it a pixel
	// wide.)
	float as_lines = strand_lod.z;
	P = P + S * (side * wd * 0.5 * (1.0 - as_lines));
	o.pos = mul(float4(P, 1.0), ViewProj);
	float3 vpos = mul(float4(P, 1.0), cam).xyz;
	o.depth = -vpos.z;
	float t = saturate(along);
	// Its strand's own number, 0 to 1, as good as random.
	float seed = frac(sin(drawn.x * 12345.678 + 0.5) * 43758.5453);
	// How much of its pixels it covers: thinner than drawn, its tip
	// fading, its material's and points' see-through, the whole avatar's.
	float thin = wd > 0.0 ? w / wd : 0.0;
	if (as_lines > 0.5) {
		// A line is a pixel wide along the picture's rows or its columns,
		// whichever it crosses: one running corner to corner covers fewer
		// pixels than a ribbon a pixel wide would - as much more solid.
		float4 on = mul(float4(pos + T * px, 1.0), ViewProj);
		if (o.pos.w > 0.0 && on.w > 0.0) {
			float2 ran = abs((on.xy / on.w - o.pos.xy / o.pos.w) * strand_view.xy);
			float longest = max(ran.x, ran.y);
			if (longest > 0.000001)
				thin = min(1.0, thin * min(1.4143, length(ran) / longest));
		}
	}
	float cover = thin * saturate(base_colour.a * col.a) * saturate((1.0 - t) * 10.0) * look.w;
	float wide = saturate(wd / max(px, 0.0000001) - 1.5);

	float3 V = normalize(-vpos);
	float3 Tv = normalize(mul(float4(T, 0.0), cam).xyz);
	float bl = length(cross(Tv, V));
	// Its facing: the middle of the hair, towards the camera.
	float3 F = V - Tv * dot(Tv, V);
	float fl = length(F);
	float3 N = fl > 0.00001 ? F / fl : V;
	// Each hair's a little lighter or darker than the next - less so the
	// fewer are drawn: a hair drawn wide stands for several, their mix.
	float3 tint = base_colour.rgb * lin(col.rgb) * (1.0 + (frac(seed * 13.7) - 0.5) * 0.24 * sqrt(drawn.z));
	float3 lit = tint;
	float3 shine = float3(0.0, 0.0, 0.0);
	if (look.x < 1.5) {
		float3 L = key_dir;
		float3 L2 = fill_dir;
		// Lit across its length (Kajiya-Kay), softened round its back.
		float tl = dot(Tv, L), tl2 = dot(Tv, L2);
		float across = sqrt(saturate(1.0 - tl * tl)), across2 = sqrt(saturate(1.0 - tl2 * tl2));
		float wrap = saturate(dot(N, L) * 0.6 + 0.4), wrap2 = saturate(dot(N, L2) * 0.6 + 0.4);
		float3 ambient = lerp(room_down, room_up, N.y * 0.5 + 0.5);
		if (look.x > 0.5) {
			float l = saturate((across * wrap - 0.4) * 6.0);
			lit = tint * (lerp(0.55, 1.0, l) * key_tint + 0.12 * room_tint);
		} else {
			lit = tint * (ambient + key_colour * (across * wrap) + fill_colour * (across2 * wrap2));
			// Two shines (Marschner's, as games draw them): white off its
			// surface, tilted towards the tip; and its own colour from
			// inside it, broader and tilted towards the root. Each hair's
			// a little different.
			float rough = saturate(surface.y);
			float e1 = lerp(320.0, 24.0, rough), e2 = e1 * 0.35;
			float jitter = (frac(seed * 7.31) - 0.5) * 0.12;
			float3 H = normalize(L + V);
			float3 T1 = normalize(Tv + N * (-0.10 + jitter));
			float3 T2 = normalize(Tv + N * (0.12 + jitter));
			float th1 = dot(T1, H), th2 = dot(T2, H);
			float s1 = pow(sqrt(saturate(1.0 - th1 * th1)), e1);
			float s2 = pow(sqrt(saturate(1.0 - th2 * th2)), e2);
			// (a hair pointing at the camera shows no shine along it)
			float strength = (1.0 - rough * 0.8) * saturate(bl * 3.0);
			shine = key_colour * key_tint * (s1 * 0.06 * strength * wrap);
			lit = lit + tint * key_tint * (s2 * 0.8 * strength * wrap);
		}
		float nv = saturate(dot(N, V));
		shine = shine + rim_light.rgb * pow(1.0 - nv, max(rim_light.w, 0.001));
	} else {
		wide = 0.0;
	}
	o.lit = float4(lit, cover);
	o.shine = shine;
	// (A line has no sides to be darker towards.)
	o.uv = float4(seed, t, side * (1.0 - as_lines), wide);
	return o;
}

// The hull: the inner layers of the hairs, drawn into the picture of the
// solid parts' distances (the nearest kept) a little further off than
// they are (strand_lod.y) - so hair well behind another part's hair is
// hidden by it, as it is by the part itself.
struct HullOut {
	float4 pos : POSITION;
	float2 at  : TEXCOORD0;
};

HullOut hull_out(float3 pos, float3 run, float4 col, float width, float order, float side)
{
	HullOut o;
	float3 T = normalize(run);
	float3 E = eye_pos - pos;
	float d = max(length(E), 0.0001);
	float3 S = cross(T, E / d);
	float sl = length(S);
	S = sl > 0.00001 ? S / sl : normalize(cross(T, float3(0.0, 1.0, 0.001)));
	float4 drawn = strand_share(order);
	float fade = drawn.y;
	float w = max(width, 0.0) * strand.z * drawn.w;
	float wd = max(w, d * strand.x * strand.y);
	float3 P = pos + S * (side * wd * 0.5);
	o.pos = mul(float4(P, 1.0), ViewProj);
	// (A see-through hair is no part of it. Every number a point comes
	// with has to be read: OpenGL won't draw with one left out.)
	o.at = float2(-mul(float4(P, 1.0), cam).z, col.a >= 0.5 ? fade : 0.0);
	return o;
}

HullOut VSHull(StrandIn v)
{
	return hull_out(v.pos.xyz, oct_dir(v.norm.xy), v.col, v.norm.z, abs(v.pos.w) - 1.0,
			v.pos.w < 0.0 ? -1.0 : 1.0);
}

float4 PSHull(HullOut v) : TARGET
{
	if (v.at.y < 0.5)
		discard;
	return float4(v.at.x + strand_lod.y, 0.0, 0.0, 1.0);
}

StrandOut VSStrand(StrandIn v)
{
	float spot = floor(v.norm.w);
	return strand_out(v.pos.xyz, oct_dir(v.norm.xy), v.col, v.norm.z, (v.norm.w - spot) / 0.9995, abs(v.pos.w) - 1.0,
			  v.pos.w < 0.0 ? -1.0 : 1.0);
}

float4 PSStrand(StrandOut v) : TARGET
{
	// Behind a solid part: hidden (the picture of their distances says;
	// hairs are drawn with no depth test of their own, so that hairs over
	// one another all show through).
	// (Its root sits on the skin, so there it still shows a little behind
	// one, strand.w - less and less further along it, and at its tip not
	// at all: a hair's end never shows through an eye or a nose.)
	// (strand_view.w 2, a test's view: the hair that's left out before
	// it's drawn, all of it shown.)
	float solid = depth_map.Load(int3(v.pos.xy, 0)).r;
	float behind = strand.w * (1.0 - v.uv.y) * (1.0 - v.uv.y);
	if ((strand_view.w < 1.5 || strand_view.w > 3.5) && v.depth > solid + behind)
		discard;
	float a = v.lit.a;
	if (a < 0.004)
		discard;
	// A wide hair is round: darker towards its sides.
	float side = v.uv.z;
	float round = lerp(1.0, 0.55 + 0.45 * sqrt(saturate(1.0 - side * side)), v.uv.w);
	float4 tex = base_map.Sample(wrapSampler, v.uv.xy);
	float3 glow = emissive * lin(emissive_map.Sample(wrapSampler, v.uv.xy).rgb);
	float3 c = lin(tex.rgb) * v.lit.rgb * round + v.shine + glow;
	return float4(srgb(c) * a, a);
}

struct DownData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

DownData VSDown(DownData v)
{
	DownData o;
	o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
	o.uv = v.uv;
	return o;
}

float4 PSDown(DownData v) : TARGET
{
	// Each pixel is the middle of 2 x 2 of the big picture's, so one
	// smooth read is their average; two more either side soften it.
	float4 c = image.Sample(clampSampler, v.uv) * 0.5;
	c = c + image.Sample(clampSampler, v.uv + float2(texel.x, 0.0)) * 0.125;
	c = c + image.Sample(clampSampler, v.uv - float2(texel.x, 0.0)) * 0.125;
	c = c + image.Sample(clampSampler, v.uv + float2(0.0, texel.y)) * 0.125;
	c = c + image.Sample(clampSampler, v.uv - float2(0.0, texel.y)) * 0.125;
	return c;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDraw(v);
		pixel_shader  = PSDraw(v);
	}
}

technique DrawBumped
{
	pass
	{
		vertex_shader = VSBumped(v);
		pixel_shader  = PSDrawBumped(v);
	}
}

technique Outline
{
	pass
	{
		vertex_shader = VSOutline(v);
		pixel_shader  = PSOutline(v);
	}
}

technique Hidden
{
	pass
	{
		vertex_shader = VSDraw(v);
		pixel_shader  = PSHidden(v);
	}
}

technique Depth
{
	pass
	{
		vertex_shader = VSDraw(v);
		pixel_shader  = PSDepth(v);
	}
}

technique Hull
{
	pass
	{
		vertex_shader = VSHull(v);
		pixel_shader  = PSHull(v);
	}
}

technique Strand
{
	pass
	{
		vertex_shader = VSStrand(v);
		pixel_shader  = PSStrand(v);
	}
}

technique Down
{
	pass
	{
		vertex_shader = VSDown(v);
		pixel_shader  = PSDown(v);
	}
}
